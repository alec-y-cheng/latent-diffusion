import struct
import mmap
import ast

def parse_npy_header(mm, start):
    """
    Parse a NumPy .npy header starting at byte offset `start`
    Returns (header_dict, data_start_offset) or (None, None)
    """
    try:
        magic = mm[start:start+6]
        if magic != b'\x93NUMPY':
            return None, None

        version = mm[start+6:start+8]
        major, minor = version[0], version[1]

        if major == 1:
            header_len = struct.unpack('<H', mm[start+8:start+10])[0]
            header_start = start + 10
        elif major in (2, 3):
            header_len = struct.unpack('<I', mm[start+8:start+12])[0]
            header_start = start + 12
        else:
            return None, None

        header_bytes = mm[header_start:header_start+header_len]
        header_str = header_bytes.decode('latin1')

        header_dict = ast.literal_eval(header_str)

        data_start = header_start + header_len
        return header_dict, data_start

    except Exception:
        return None, None


def inspect_corrupted_npz(file_path, max_arrays=50):
    print(f"\nInspecting file: {file_path}\n")

    with open(file_path, "rb") as f:
        mm = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)

        print(f"File size: {len(mm)/1e9:.2f} GB\n")

        offset = 0
        found = 0

        while True:
            idx = mm.find(b'\x93NUMPY', offset)
            if idx == -1:
                break

            print(f"Found potential .npy array at byte offset: {idx}")

            header, data_start = parse_npy_header(mm, idx)

            if header is not None:
                print("  Header parsed successfully:")
                print(f"    dtype: {header.get('descr')}")
                print(f"    shape: {header.get('shape')}")
                print(f"    fortran_order: {header.get('fortran_order')}")

                # Estimate size (safe, no loading)
                shape = header.get('shape', ())
                dtype = header.get('descr')

                try:
                    import numpy as np
                    itemsize = np.dtype(dtype).itemsize
                    numel = 1
                    for s in shape:
                        numel *= s
                    total_bytes = numel * itemsize

                    print(f"    estimated size: {total_bytes/1e6:.2f} MB")

                except Exception:
                    print("    could not estimate size")

            else:
                print("  Failed to parse header (likely truncated)")

            print()
            found += 1
            offset = idx + 1

            if found >= max_arrays:
                print("Reached max_arrays limit, stopping scan.")
                break

        print(f"\nTotal arrays detected: {found}")
        mm.close()


if __name__ == "__main__":
    inspect_corrupted_npz("data/uk_set/expanded_dataset_1000_uk.npz")